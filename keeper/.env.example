# Which chain: arbitrumSepolia | arbitrum | foundry (local anvil)
CHAIN=arbitrumSepolia
ALLOW_TESTNET_DEPLOYMENT=false
RPC_URL=
# Optional comma-separated read RPC failover list. RPC_URL remains the primary write endpoint.
RPC_URLS=
TABLINE_ADDRESS=0x...
# Keeper key. In eoa mode this EOA is the delegate; in smart-account mode it owns the delegate smart account.
# Fund the delegate address (printed at startup) with a little ETH for gas. Keep this key isolated.
KEEPER_PK=0x...
# Set BUNDLER_URL to use the preferred atomic smart-account mode. Leave empty for EOA sequential mode.
BUNDLER_URL=
PORT=8787
# Production default. Use DATA_FILE=./tabline-data.json only for a simple development fallback.
DATABASE_URL=sqlite:./tabline.db
DATA_FILE=
CYCLE_SECONDS=30
# Comma-separated browser origins; include 127.0.0.1 if you open the app using that hostname.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated wallet addresses allowed to access merchant operations. Required in production.
MERCHANT_ADDRESSES=
SESSION_SECRET=replace-with-at-least-32-random-characters
WEBHOOK_URL=
# Required only when WEBHOOK_URL is configured.
WEBHOOK_SECRET=
# Set true only behind HTTPS in production. Production also requires CHAIN=arbitrum,
# REDEEM_MODE=smart-account, BUNDLER_URL, explicit CORS_ORIGIN, and WEBHOOK_SECRET.
COOKIE_SECURE=false
