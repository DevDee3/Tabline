{
  "name": "tabline-keeper",
  "private": true,
  "type": "module",
  "scripts": {
    "abi": "node scripts/gen-abi.mjs",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "npm run build && node --env-file=.env dist/index.js"
  },
  "dependencies": {
    "@metamask/smart-accounts-kit": "latest",
    "viem": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
