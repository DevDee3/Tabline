# Keeper API the app talks to (see keeper/.env.example). Leave unset to run in demo mode (simulated backend,
# no wallet/chain needed) -- see src/lib/env.ts and src/lib/demo.ts.
NEXT_PUBLIC_KEEPER_URL=http://localhost:8787
# Optional server-side target for the same-origin /api/keeper proxy. Defaults to NEXT_PUBLIC_KEEPER_URL.
# KEEPER_INTERNAL_URL=http://localhost:8787
# Plan ids created on-chain for the demo merchant "Inkwell" (see scripts/dev-local.sh).
NEXT_PUBLIC_PLAN_FIXED=1
NEXT_PUBLIC_PLAN_METERED=2
# ERC-20 token address on the same chain as keeper/.env CHAIN (leave blank until verified).
# Do not reuse an Arbitrum One token address when running on Arbitrum Sepolia.
NEXT_PUBLIC_TOKEN_ADDRESS=


KEEPER_INTERNAL_URL=https://billing.example.com
NEXT_PUBLIC_KEEPER_URL=https://billing.example.com